# Variables d'environnement pour le projet STANTECH

# Clé secrète Django (Mettre une clé forte en production)
SECRET_KEY=votre_cle_secrete_django_ici

# Mettre à False en production
DEBUG=True

# Hôtes autorisés (ex: monsite.railway.app, localhost)
ALLOWED_HOSTS=localhost,127.0.0.1,.railway.app

# Origines approuvées pour CSRF (ex: https://monsite.railway.app)
CSRF_TRUSTED_ORIGINS=https://localhost,http://127.0.0.1

# Configuration de la base de données (Fournie par Railway en prod, laisse vide ou supprime pour utiliser SQLite en local)
# DATABASE_URL=postgres://user:password@host:port/dbname
